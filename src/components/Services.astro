---
// Services Section — 3 Standardized Solutions
---

<section class="section services" id="services" data-story-section="services">
  <div class="container">
    <div class="section-header reveal">
      <span class="section-label">服务方案</span>
      <h2 class="section-title">标准化 AI 交付</h2>
      <p class="section-desc">
        不卖概念，只交付可落地的 AI 解决方案。<br />
        每套方案都有明确的适用场景、交付物和价格。
      </p>
    </div>

    <div class="services-story-lines" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
    </div>

    <div class="services-grid">
      <!-- Service 1: Knowledge Base -->
      <div class="service-card card reveal" data-service-story="0">
        <div class="icon-box service-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
            <path d="M8 7h8M8 11h6"/>
          </svg>
        </div>
        <div class="service-tag">知识库方案</div>
        <h3 class="service-title">AI 知识库搭建</h3>
        <p class="service-desc">
          让你的知识不再散落在微信收藏、浏览器书签和脑子里。搭建专属的 AI 协作知识系统，知识沉淀、标准化、可复用。
        </p>
        <div class="service-details">
          <div class="service-detail">
            <span class="service-detail-label">适用对象</span>
            <span class="service-detail-value">个人 / 内容创作者</span>
          </div>
          <div class="service-detail">
            <span class="service-detail-label">核心价值</span>
            <span class="service-detail-value">知识沉淀 · 标准化复用</span>
          </div>
          <div class="service-detail">
            <span class="service-detail-label">交付物</span>
            <span class="service-detail-value">知识库架构 + 模板 + AI Skill + 使用手册</span>
          </div>
        </div>
        <a href="#contact" class="btn btn-outline service-btn">免费咨询 · 获取报价</a>
      </div>

      <!-- Service 2: Local Model -->
      <div class="service-card card reveal reveal-delay-1" data-service-story="1">
        <div class="icon-box service-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            <circle cx="12" cy="16" r="1"/>
          </svg>
        </div>
        <div class="service-tag">本地模型方案</div>
        <h3 class="service-title">私有化 AI 部署</h3>
        <p class="service-desc">
          数据不出本地，AI 能力不打折。为数据敏感型企业提供私有化部署方案，安全合规，定制化咨询。
        </p>
        <div class="service-details">
          <div class="service-detail">
            <span class="service-detail-label">适用对象</span>
            <span class="service-detail-value">数据敏感企业 / 律所 / 金融机构</span>
          </div>
          <div class="service-detail">
            <span class="service-detail-label">核心价值</span>
            <span class="service-detail-value">数据安全 · 私有化部署</span>
          </div>
          <div class="service-detail">
            <span class="service-detail-label">交付物</span>
            <span class="service-detail-value">本地模型 + 搜索增强 + Skills + 部署文档</span>
          </div>
        </div>
        <a href="#contact" class="btn btn-outline service-btn">免费咨询 · 获取报价</a>
      </div>

      <!-- Service 3: Content Workflow -->
      <div class="service-card card service-card-featured reveal reveal-delay-2" data-service-story="2">
        <div class="service-popular">推荐</div>
        <div class="icon-box service-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/>
            <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
            <line x1="12" y1="19" x2="12" y2="23"/>
            <line x1="8" y1="23" x2="16" y2="23"/>
          </svg>
        </div>
        <div class="service-tag">口播工作流方案</div>
        <h3 class="service-title">自媒体 AI 全链路</h3>
        <p class="service-desc">
          从选题到脚本到录制到剪辑，AI 全链路参与。让你专注内容本身，把重复劳动交给 AI。内容量产，风格统一，多平台分发。
        </p>
        <div class="service-details">
          <div class="service-detail">
            <span class="service-detail-label">适用对象</span>
            <span class="service-detail-value">垂类博主 / 内容创业者</span>
          </div>
          <div class="service-detail">
            <span class="service-detail-label">核心价值</span>
            <span class="service-detail-value">内容量产 · 风格统一 · 多平台分发</span>
          </div>
          <div class="service-detail">
            <span class="service-detail-label">交付物</span>
            <span class="service-detail-value">工作流 SOP + AI 脚本模板 + 多平台适配 + 培训</span>
          </div>
        </div>
        <a href="#contact" class="btn btn-primary service-btn">免费咨询 · 获取报价</a>
      </div>
    </div>
  </div>
</section>

<style>
  .services {
    overflow: hidden;
  }

  .services > .container {
    position: relative;
    z-index: 2;
  }

  .services-story-lines {
    position: absolute;
    z-index: 1;
    top: 248px;
    left: max(24px, calc((100% - var(--container-width)) / 2 + 24px));
    right: max(24px, calc((100% - var(--container-width)) / 2 + 24px));
    bottom: 72px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    pointer-events: none;
  }

  .services-story-lines span {
    position: relative;
  }

  .services-story-lines span::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    width: 1px;
    height: 100%;
    background: linear-gradient(
      180deg,
      transparent,
      rgba(234, 211, 141, 0.72) 22%,
      rgba(201, 165, 92, 0.2) 76%,
      transparent
    );
    box-shadow: 0 0 18px rgba(201, 165, 92, 0.24);
    opacity: 0;
    transform: scaleY(0);
    transform-origin: top;
    transition: opacity 0.45s ease, transform 0.85s var(--ease-out), filter 0.35s ease;
  }

  .services.story-active .services-story-lines span::before {
    opacity: 0.62;
    transform: scaleY(1);
  }

  .services[data-service-focus] .services-story-lines span::before {
    opacity: 0.2;
  }

  .services[data-service-focus='0'] .services-story-lines span:nth-child(1)::before,
  .services[data-service-focus='1'] .services-story-lines span:nth-child(2)::before,
  .services[data-service-focus='2'] .services-story-lines span:nth-child(3)::before {
    opacity: 1;
    filter: brightness(1.45);
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    align-items: start;
    position: relative;
    z-index: 2;
    perspective: 1200px;
  }

  .service-card {
    padding: 36px 28px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    position: relative;
    transform: perspective(1100px) translate3d(0, 20px, 0);
    border-color: rgba(201, 165, 92, 0.08);
    transition:
      transform 0.58s var(--ease-out),
      opacity 0.35s ease,
      border-color 0.35s ease,
      box-shadow 0.35s ease,
      background 0.35s ease;
    min-height: 100%;
  }

  .service-card:nth-child(1),
  .service-card:nth-child(2) {
    margin-top: 32px;
  }

  .service-card-featured {
    min-height: calc(100% + 18px);
    padding-top: 44px;
    box-shadow: 0 24px 74px rgba(0, 0, 0, 0.3);
  }

  .service-card.story-active {
    transform: perspective(1100px) translate3d(0, 0, 12px);
    border-color: rgba(201, 165, 92, 0.28);
    box-shadow:
      0 20px 58px rgba(0, 0, 0, 0.3),
      inset 0 1px 0 rgba(234, 211, 141, 0.08);
  }

  .services[data-service-focus] .service-card {
    opacity: 0.72;
  }

  .services[data-service-focus='0'] .service-card:nth-child(1),
  .services[data-service-focus='1'] .service-card:nth-child(2),
  .services[data-service-focus='2'] .service-card:nth-child(3) {
    opacity: 1;
    transform: perspective(1100px) translate3d(0, -6px, 26px);
    border-color: rgba(234, 211, 141, 0.46);
    box-shadow:
      0 26px 72px rgba(0, 0, 0, 0.4),
      0 0 30px rgba(201, 165, 92, 0.08);
  }

  .service-card-featured {
    border-color: rgba(201, 165, 92, 0.3);
    background: linear-gradient(180deg, rgba(201, 165, 92, 0.04), var(--bg-card));
  }

  .service-card-featured:hover {
    border-color: rgba(201, 165, 92, 0.5);
  }

  .service-popular {
    position: absolute;
    top: -1px;
    right: 24px;
    background: var(--accent);
    color: #0a0a0a;
    font-size: 11px;
    font-weight: 700;
    padding: 4px 12px;
    border-radius: 0 0 6px 6px;
    letter-spacing: 0.5px;
  }

  .service-tag {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--accent);
    font-weight: 600;
    letter-spacing: 0.5px;
  }

  .service-tag::before {
    content: '';
    width: 16px;
    height: 1px;
    flex: 0 0 auto;
    background: linear-gradient(90deg, var(--accent), rgba(201, 165, 92, 0.18));
  }

  .service-title {
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .service-desc {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .service-details {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 20px 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .service-detail {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
  }

  .service-detail-label {
    font-size: 12px;
    color: var(--text-muted);
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .service-detail-value {
    font-size: 13px;
    color: var(--text-secondary);
    text-align: right;
  }

  .service-btn {
    width: 100%;
    justify-content: center;
    margin-top: auto;
  }

  @media (max-width: 1024px) {
    .services-story-lines {
      display: none;
    }

    .services-grid {
      gap: 20px;
    }

    .service-card {
      padding: 32px 24px;
    }

    .service-card:nth-child(1),
    .service-card:nth-child(2) {
      margin-top: 18px;
    }
  }

  @media (max-width: 768px) {
    .services-grid {
      grid-template-columns: 1fr;
      max-width: 480px;
      margin: 0 auto;
    }

    .service-card {
      padding: 28px 24px;
      transform: translateY(14px);
      min-height: 0;
      margin-top: 0;
    }

    .service-card:nth-child(1),
    .service-card:nth-child(2) {
      margin-top: 0;
    }

    .service-card.story-active,
    .services[data-service-focus='0'] .service-card:nth-child(1),
    .services[data-service-focus='1'] .service-card:nth-child(2),
    .services[data-service-focus='2'] .service-card:nth-child(3) {
      transform: translateY(0);
    }

    .service-title {
      font-size: 20px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .service-card,
    .service-card.story-active {
      transform: none;
    }
  }
</style>

<script>
  const servicesSection = document.querySelector<HTMLElement>('[data-story-section="services"]');

  if (servicesSection && !servicesSection.dataset.storyBound) {
    servicesSection.dataset.storyBound = 'true';
    const cards = Array.from(servicesSection.querySelectorAll<HTMLElement>('[data-service-story]'));
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const setFocus = (index: string | null) => {
      if (index === null) delete servicesSection.dataset.serviceFocus;
      else servicesSection.dataset.serviceFocus = index;
    };

    cards.forEach((card) => {
      const index = card.dataset.serviceStory || '0';
      card.addEventListener('pointerenter', () => setFocus(index));
      card.addEventListener('pointerleave', () => setFocus(null));
      card.addEventListener('focusin', () => setFocus(index));
      card.addEventListener('focusout', (event) => {
        if (!card.contains(event.relatedTarget as Node | null)) setFocus(null);
      });
    });

    window.addEventListener('visual-story:update', (event) => {
      const detail = (event as CustomEvent<{ section: string; progress: number }>).detail;
      const active = detail.section === 'services';
      servicesSection.classList.toggle('story-active', active);
      if (!active) return;

      cards.forEach((card, index) => {
        card.classList.toggle('story-active', reducedMotion || detail.progress >= 0.05 + index * 0.14);
      });
    });
  }
</script>
