---
// Why Me Section — 3 Differentiators
---

<section class="section whyme" id="whyme" data-story-section="whyme">
  <div class="container">
    <div class="section-header reveal">
      <span class="section-label">为什么选我</span>
      <h2 class="section-title">懂业务、懂 AI、能落地</h2>
      <p class="section-desc">
        不是纯技术 geek，也不是只会卖课的博主。<br />
        是真正从一线业务里长出来的 AI 落地执行者。
      </p>
    </div>

    <div class="whyme-story-lines" aria-hidden="true">
      <span class="whyme-story-line"></span>
      <span class="whyme-story-line"></span>
      <span class="whyme-story-line"></span>
    </div>

    <div class="whyme-grid">
      <!-- Card 1: 懂业务 -->
      <div class="whyme-card card reveal reveal-delay-1" data-story-card="0">
        <div class="icon-box whyme-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
          </svg>
        </div>
        <h3 class="whyme-card-title">懂业务</h3>
        <p class="whyme-card-desc">
          4 年家居获客操盘，服务过欧派等品牌，管理过数百万级广告预算。从 3 人团队带到 40+ 人，年销 5000 万。我知道企业要的不是 AI 技术，是业绩增长。
        </p>
        <div class="whyme-card-data">
          <div class="whyme-data-item">
            <span class="whyme-data-value counter" data-target="5000" data-suffix="万">5,000万</span>
            <span class="whyme-data-label">年销售额</span>
          </div>
          <div class="whyme-data-item">
            <span class="whyme-data-value counter" data-target="40" data-suffix="+人">40+人</span>
            <span class="whyme-data-label">团队规模</span>
          </div>
        </div>
      </div>

      <!-- Card 2: 懂 AI -->
      <div class="whyme-card card reveal reveal-delay-2" data-story-card="1">
        <div class="icon-box whyme-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 2a4 4 0 0 1 4 4c0 1.95-1.4 3.58-3.25 3.93"/>
            <path d="M8 6a4 4 0 0 1 8 0"/>
            <circle cx="12" cy="14" r="4"/>
            <path d="M12 18v4"/>
            <path d="M8 22h8"/>
          </svg>
        </div>
        <h3 class="whyme-card-title">懂 AI</h3>
        <p class="whyme-card-desc">
          Google Gemini 认证 × 3、UNESCO OER 证书、阿里云 AI 训练师（高级）。30+ 工具深度实操，自建 OrbitOS 多 AI 协作知识管理系统。
        </p>
        <div class="whyme-card-data">
          <div class="whyme-data-item">
            <span class="whyme-data-value counter" data-target="7" data-suffix="项">7项</span>
            <span class="whyme-data-label">权威认证</span>
          </div>
          <div class="whyme-data-item">
            <span class="whyme-data-value counter" data-target="30" data-suffix="+">30+</span>
            <span class="whyme-data-label">AI 工具实操</span>
          </div>
        </div>
      </div>

      <!-- Card 3: 能落地 -->
      <div class="whyme-card card reveal reveal-delay-1" data-story-card="2">
        <div class="icon-box whyme-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 2v20M2 12h20"/>
            <circle cx="12" cy="12" r="10"/>
            <path d="m9 12 2 2 4-4"/>
          </svg>
        </div>
        <h3 class="whyme-card-title">能落地</h3>
        <p class="whyme-card-desc">
          3 套标准化 AI 交付方案已上线，微信小程序 0 编程独立完成并上线，YouTube Shorts 半个月 500 万+播放。说得出，做得到，拿得出结果。
        </p>
        <div class="whyme-card-data">
          <div class="whyme-data-item">
            <span class="whyme-data-value counter" data-target="3" data-suffix="套">3套</span>
            <span class="whyme-data-label">交付方案</span>
          </div>
          <div class="whyme-data-item">
            <span class="whyme-data-value counter" data-target="500" data-suffix="万+">500万+</span>
            <span class="whyme-data-label">YouTube 播放</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .whyme {
    background: var(--bg-surface);
    overflow: hidden;
  }

  .whyme-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    position: relative;
    z-index: 2;
    perspective: 1200px;
  }

  .whyme-story-lines {
    position: absolute;
    z-index: 1;
    top: 248px;
    left: max(24px, calc((100% - var(--container-width)) / 2 + 24px));
    right: max(24px, calc((100% - var(--container-width)) / 2 + 24px));
    bottom: 72px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    pointer-events: none;
  }

  .whyme-story-line {
    position: relative;
    overflow: hidden;
  }

  .whyme-story-line::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    width: 1px;
    height: 100%;
    background: linear-gradient(
      180deg,
      transparent,
      rgba(234, 211, 141, 0.74) 20%,
      rgba(201, 165, 92, 0.26) 72%,
      transparent
    );
    box-shadow: 0 0 18px rgba(201, 165, 92, 0.28);
    opacity: 0;
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.9s var(--ease-out), opacity 0.5s ease;
  }

  .whyme:has(.whyme-card:nth-child(1).story-active) .whyme-story-line:nth-child(1)::before,
  .whyme:has(.whyme-card:nth-child(2).story-active) .whyme-story-line:nth-child(2)::before,
  .whyme:has(.whyme-card:nth-child(3).story-active) .whyme-story-line:nth-child(3)::before {
    opacity: 1;
    transform: scaleY(1);
  }

  .whyme-card {
    --tilt-x: 0deg;
    --tilt-y: 0deg;
    padding: 40px 32px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    transform:
      perspective(1000px)
      translate3d(0, 12px, 0)
      rotateX(var(--tilt-x))
      rotateY(var(--tilt-y));
    transform-style: preserve-3d;
    border-color: rgba(201, 165, 92, 0.08);
    transition:
      transform 0.55s var(--ease-out),
      border-color 0.45s ease,
      box-shadow 0.45s ease,
      background 0.45s ease;
  }

  .whyme-card.story-active {
    transform:
      perspective(1000px)
      translate3d(0, 0, 18px)
      rotateX(var(--tilt-x))
      rotateY(var(--tilt-y));
    border-color: rgba(201, 165, 92, 0.34);
    background:
      linear-gradient(150deg, rgba(201, 165, 92, 0.055), transparent 42%),
      var(--bg-card);
    box-shadow:
      0 24px 70px rgba(0, 0, 0, 0.34),
      inset 0 1px 0 rgba(234, 211, 141, 0.1);
  }

  .whyme-card.story-active .whyme-icon {
    box-shadow: 0 0 28px rgba(201, 165, 92, 0.16);
    border-color: rgba(201, 165, 92, 0.34);
  }

  .whyme-card.story-active .whyme-data-value {
    text-shadow: 0 0 22px rgba(201, 165, 92, 0.28);
  }

  .whyme-card-title {
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .whyme-card-desc {
    font-size: 15px;
    color: var(--text-secondary);
    line-height: 1.8;
    flex: 1;
  }

  .whyme-card-data {
    display: flex;
    justify-content: center;
    gap: 48px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
  }

  .whyme-data-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .whyme-data-value {
    font-size: 24px;
    font-weight: 800;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }

  .whyme-data-label {
    font-size: 12px;
    color: var(--text-muted);
    font-weight: 500;
  }

  @media (max-width: 1024px) {
    .whyme-story-lines {
      display: none;
    }

    .whyme-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .whyme-card:nth-child(3) {
      grid-column: span 2;
    }
  }

  @media (max-width: 768px) {
    .whyme-grid {
      grid-template-columns: 1fr;
    }

    .whyme-card:nth-child(3) {
      grid-column: span 1;
      max-width: 100%;
    }

    .whyme-card {
      padding: 32px 24px;
      transform: translateY(8px);
    }

    .whyme-card.story-active {
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .whyme-card,
    .whyme-card.story-active {
      transform: none;
    }
  }
</style>

<script>
  const whyMeSection = document.querySelector<HTMLElement>('[data-story-section="whyme"]');

  if (whyMeSection && !whyMeSection.dataset.storyBound) {
    whyMeSection.dataset.storyBound = 'true';
    const cards = Array.from(whyMeSection.querySelectorAll<HTMLElement>('[data-story-card]'));
    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const handleStoryUpdate = (event: Event) => {
      const detail = (event as CustomEvent<{ section: string; progress: number }>).detail;
      if (detail.section !== 'whyme') return;

      cards.forEach((card, index) => {
        const threshold = 0.05 + index * 0.14;
        card.classList.toggle('story-active', reducedMotion || detail.progress >= threshold);
      });
    };

    window.addEventListener('visual-story:update', handleStoryUpdate);

    if (finePointer && !reducedMotion) {
      cards.forEach((card) => {
        card.addEventListener('pointermove', (event) => {
          const bounds = card.getBoundingClientRect();
          const x = (event.clientX - bounds.left) / bounds.width - 0.5;
          const y = (event.clientY - bounds.top) / bounds.height - 0.5;
          card.style.setProperty('--tilt-x', `${(-y * 4).toFixed(2)}deg`);
          card.style.setProperty('--tilt-y', `${(x * 4).toFixed(2)}deg`);
        });
        card.addEventListener('pointerleave', () => {
          card.style.setProperty('--tilt-x', '0deg');
          card.style.setProperty('--tilt-y', '0deg');
        });
      });
    }
  }
</script>
