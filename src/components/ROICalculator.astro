---
// ROI Calculator — Interactive investment return estimator
---

<section class="section roi" id="roi" data-story-section="roi">
  <div class="roi-ambient-wave" aria-hidden="true"></div>
  <div class="container">
    <div class="section-header reveal">
      <span class="section-label">投入产出</span>
      <h2 class="section-title">AI 能帮你省多少钱？</h2>
      <p class="section-desc">
        拖动下方滑块，实时计算 AI 赋能后的预期收益。<br />
        基于真实客户案例数据估算。
      </p>
    </div>

    <div class="roi-card card reveal reveal-delay-1">
      <div class="roi-inputs">
        <div class="roi-preset-block">
          <span class="roi-preset-label">参数预设</span>
          <div class="roi-presets" role="group" aria-label="ROI 参数预设">
            <button
              type="button"
              class="roi-preset"
              data-roi-preset="starter"
              data-cost="120"
              data-leads="50"
              data-hours="1.5"
              aria-pressed="false"
            >
              轻量尝试
            </button>
            <button
              type="button"
              class="roi-preset is-active"
              data-roi-preset="growth"
              data-cost="200"
              data-leads="100"
              data-hours="3"
              aria-pressed="true"
            >
              成长业务
            </button>
            <button
              type="button"
              class="roi-preset"
              data-roi-preset="scale"
              data-cost="320"
              data-leads="300"
              data-hours="5"
              aria-pressed="false"
            >
              高投入团队
            </button>
            <button
              type="button"
              class="roi-preset"
              data-roi-preset="custom"
              aria-pressed="false"
            >
              自定义
            </button>
          </div>
        </div>

        <!-- 当前获客成本 -->
        <div class="roi-input-group">
          <label class="roi-label" for="costSlider">
            <span class="roi-label-text">当前单条获客成本</span>
            <span class="roi-label-value" id="costValue">200 元</span>
          </label>
          <input type="range" class="roi-slider" id="costSlider" min="50" max="500" value="200" step="10" />
          <div class="roi-range">
            <span>50 元</span>
            <span>500 元</span>
          </div>
        </div>

        <!-- 每月线索数 -->
        <div class="roi-input-group">
          <label class="roi-label" for="leadsSlider">
            <span class="roi-label-text">每月获取线索数</span>
            <span class="roi-label-value" id="leadsValue">100 条</span>
          </label>
          <input type="range" class="roi-slider" id="leadsSlider" min="10" max="500" value="100" step="10" />
          <div class="roi-range">
            <span>10 条</span>
            <span>500 条</span>
          </div>
        </div>

        <!-- 数据整理耗时 -->
        <div class="roi-input-group">
          <label class="roi-label" for="hoursSlider">
            <span class="roi-label-text">每天数据整理耗时</span>
            <span class="roi-label-value" id="hoursValue">3 小时</span>
          </label>
          <input type="range" class="roi-slider" id="hoursSlider" min="0.5" max="8" value="3" step="0.5" />
          <div class="roi-range">
            <span>0.5 小时</span>
            <span>8 小时</span>
          </div>
        </div>
      </div>

      <div class="roi-results">
        <div class="roi-result-header">AI 赋能后预计</div>

        <div class="roi-result-item">
          <span class="roi-result-label">每月获客成本节省</span>
          <span class="roi-result-value roi-highlight" id="savingsValue" aria-live="polite">¥6,000</span>
        </div>

        <div class="roi-result-item">
          <span class="roi-result-label">获客成本降幅</span>
          <span class="roi-result-value" id="costReduction" aria-live="polite">30%</span>
        </div>

        <div class="roi-result-item">
          <span class="roi-result-label">每月节省工时</span>
          <span class="roi-result-value" id="hoursSaved" aria-live="polite">33 小时</span>
        </div>

        <div class="roi-result-item roi-total">
          <span class="roi-result-label">年度综合节省</span>
          <span class="roi-result-value roi-total-value" id="annualValue" aria-live="polite">¥91,800</span>
        </div>

        <div class="roi-note">
          * 保守估计：获客成本降 30%，数据整理时间省 50%，时薪按 50 元计算
        </div>

        <div class="roi-insight" aria-live="polite">
          <span class="roi-insight-label">测算解读</span>
          <p id="roiInsight"></p>
        </div>

        <a href="#contact" class="btn btn-primary roi-cta">获取我的 AI 落地方案</a>
      </div>
    </div>
  </div>
</section>

<style>
  .roi {
    background: var(--bg);
    overflow: hidden;
  }

  .roi-ambient-wave {
    position: absolute;
    z-index: 0;
    top: 26%;
    right: -10%;
    width: min(54vw, 760px);
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1px solid rgba(201, 165, 92, 0.08);
    box-shadow:
      0 0 0 42px rgba(201, 165, 92, 0.025),
      0 0 0 96px rgba(201, 165, 92, 0.018);
    opacity: 0;
    transform: scale(0.8);
    transition: opacity 0.8s ease, transform 1s var(--ease-out);
    pointer-events: none;
  }

  .roi.story-active .roi-ambient-wave {
    opacity: 1;
    transform: scale(1);
  }

  .roi > .container {
    position: relative;
    z-index: 1;
  }

  .roi-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    padding: 48px;
    overflow: hidden;
    border-color: rgba(201, 165, 92, 0.14);
    background:
      linear-gradient(145deg, rgba(201, 165, 92, 0.035), transparent 38%),
      var(--bg-card);
  }

  .roi-inputs {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .roi-preset-block {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .roi-preset-label {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    color: var(--text-muted);
    letter-spacing: 0.5px;
  }

  .roi-presets {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    padding: 3px;
    border: 1px solid var(--border);
    border-radius: 7px;
    background: rgba(10, 10, 10, 0.42);
  }

  .roi-preset {
    min-height: 36px;
    padding: 7px 8px;
    border: 0;
    border-radius: 5px;
    background: transparent;
    color: var(--text-muted);
    font-family: inherit;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    transition:
      background 0.25s ease,
      color 0.25s ease,
      box-shadow 0.25s ease;
  }

  .roi-preset:hover,
  .roi-preset:focus-visible {
    color: var(--text-primary);
  }

  .roi-preset.is-active {
    color: #0a0a0a;
    background: var(--accent);
    box-shadow: 0 4px 16px rgba(201, 165, 92, 0.2);
  }

  .roi-input-group {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .roi-label {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .roi-label-text {
    font-size: 14px;
    color: var(--text-secondary);
    font-weight: 500;
  }

  .roi-label-value {
    font-size: 16px;
    font-weight: 700;
    color: var(--accent);
    font-family: var(--font-mono);
  }

  .roi-slider {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 6px;
    --slider-progress: 33.33%;
    background: linear-gradient(
      90deg,
      rgba(234, 211, 141, 0.92) 0,
      var(--accent) var(--slider-progress),
      var(--border) var(--slider-progress),
      var(--border) 100%
    );
    border-radius: 3px;
    outline: none;
    cursor: pointer;
    box-shadow: 0 0 16px rgba(201, 165, 92, 0.08);
  }

  .roi-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--accent);
    cursor: pointer;
    border: 3px solid var(--bg-card);
    box-shadow: 0 2px 8px rgba(201, 165, 92, 0.3);
    transition: transform 0.2s;
  }

  .roi-slider::-webkit-slider-thumb:hover {
    transform: scale(1.1);
  }

  .roi-slider::-moz-range-thumb {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--accent);
    cursor: pointer;
    border: 3px solid var(--bg-card);
    box-shadow: 0 2px 8px rgba(201, 165, 92, 0.3);
  }

  .roi-range {
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    color: var(--text-muted);
  }

  .roi-results {
    background: var(--bg-surface);
    border-radius: 12px;
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }

  .roi-results::before,
  .roi-results::after {
    content: '';
    position: absolute;
    z-index: -1;
    left: 76%;
    top: 46%;
    width: 180px;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1px solid rgba(201, 165, 92, 0.16);
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.25);
  }

  .roi-results::after {
    width: 270px;
    border-color: rgba(201, 165, 92, 0.08);
  }

  .roi-results.is-pulsing::before {
    animation: roiResultWave 0.72s var(--ease-out) 1;
  }

  .roi-results.is-pulsing::after {
    animation: roiResultWave 0.9s var(--ease-out) 0.08s 1;
  }

  @keyframes roiResultWave {
    0% {
      opacity: 0.54;
      transform: translate(-50%, -50%) scale(0.25);
    }
    100% {
      opacity: 0;
      transform: translate(-50%, -50%) scale(1.18);
    }
  }

  .roi-result-header {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-secondary);
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border);
  }

  .roi-result-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .roi-result-label {
    font-size: 14px;
    color: var(--text-secondary);
  }

  .roi-result-value {
    font-size: 18px;
    font-weight: 700;
    font-family: var(--font-mono);
    color: var(--text-primary);
  }

  .roi-highlight {
    color: #22c55e;
    font-size: 22px;
  }

  .roi-total {
    padding-top: 16px;
    border-top: 1px solid var(--border);
  }

  .roi-total-value {
    color: var(--accent);
    font-size: 24px;
    position: relative;
    overflow: hidden;
    transition: transform 0.32s var(--ease-out), text-shadow 0.32s ease;
  }

  .roi-total-value.is-updating {
    transform: scale(1.04);
    text-shadow: 0 0 24px rgba(201, 165, 92, 0.38);
  }

  .roi-total-value::after {
    content: '';
    position: absolute;
    inset: -20% auto -20% -40%;
    width: 28%;
    background: linear-gradient(90deg, transparent, rgba(255, 248, 218, 0.78), transparent);
    opacity: 0;
    transform: skewX(-16deg);
    pointer-events: none;
  }

  .roi-total-value.is-updating::after {
    animation: roiValueSweep 0.62s var(--ease-out) 1;
  }

  @keyframes roiValueSweep {
    0% {
      left: -40%;
      opacity: 0;
    }
    20% {
      opacity: 0.7;
    }
    100% {
      left: 120%;
      opacity: 0;
    }
  }

  .roi-note {
    font-size: 12px;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .roi-insight {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 14px 0 0;
    border-top: 1px solid var(--border);
  }

  .roi-insight-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    color: var(--accent);
    letter-spacing: 0.5px;
  }

  .roi-insight p {
    color: var(--text-secondary);
    font-size: 13px;
    line-height: 1.65;
  }

  .roi-cta {
    text-align: center;
    justify-content: center;
    margin-top: 8px;
  }

  @media (max-width: 768px) {
    .roi-ambient-wave {
      right: -42%;
      width: 92vw;
      opacity: 0.45;
    }

    .roi-card {
      grid-template-columns: 1fr;
      padding: 28px 24px;
      gap: 32px;
    }

    .roi-results {
      padding: 24px;
    }

    .roi-presets {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .roi-result-value {
      font-size: 16px;
    }

    .roi-highlight {
      font-size: 20px;
    }

    .roi-total-value {
      font-size: 22px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .roi-ambient-wave,
    .roi.story-active .roi-ambient-wave {
      opacity: 0.35;
      transform: none;
    }

    .roi-results::before,
    .roi-results::after,
    .roi-total-value::after {
      display: none;
    }
  }
</style>

<script>
  const costSlider = document.getElementById('costSlider') as HTMLInputElement;
  const leadsSlider = document.getElementById('leadsSlider') as HTMLInputElement;
  const hoursSlider = document.getElementById('hoursSlider') as HTMLInputElement;

  const costValue = document.getElementById('costValue')!;
  const leadsValue = document.getElementById('leadsValue')!;
  const hoursValue = document.getElementById('hoursValue')!;
  const savingsValue = document.getElementById('savingsValue')!;
  const costReduction = document.getElementById('costReduction')!;
  const hoursSaved = document.getElementById('hoursSaved')!;
  const annualValue = document.getElementById('annualValue')!;
  const roiInsight = document.getElementById('roiInsight')!;
  const roiSection = document.querySelector<HTMLElement>('[data-story-section="roi"]');
  const roiResults = roiSection?.querySelector<HTMLElement>('.roi-results');
  const presetButtons = Array.from(
    roiSection?.querySelectorAll<HTMLButtonElement>('[data-roi-preset]') || [],
  );
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let pulseTimer = 0;

  function setActivePreset(preset: string) {
    presetButtons.forEach((button) => {
      const isActive = button.dataset.roiPreset === preset;
      button.classList.toggle('is-active', isActive);
      button.setAttribute('aria-pressed', String(isActive));
    });
  }

  function setSliderProgress(slider: HTMLInputElement) {
    const min = parseFloat(slider.min);
    const max = parseFloat(slider.max);
    const value = parseFloat(slider.value);
    const progress = ((value - min) / (max - min)) * 100;
    slider.style.setProperty('--slider-progress', `${progress.toFixed(2)}%`);
  }

  function triggerResultFeedback() {
    if (reducedMotion || !roiResults) return;
    window.clearTimeout(pulseTimer);
    roiResults.classList.remove('is-pulsing');
    annualValue.classList.remove('is-updating');
    requestAnimationFrame(() => {
      roiResults.classList.add('is-pulsing');
      annualValue.classList.add('is-updating');
      pulseTimer = window.setTimeout(() => {
        roiResults.classList.remove('is-pulsing');
        annualValue.classList.remove('is-updating');
      }, 920);
    });
  }

  function calculate(animate = true) {
    const cost = parseFloat(costSlider.value);
    const leads = parseFloat(leadsSlider.value);
    const hours = parseFloat(hoursSlider.value);

    // Update labels
    costValue.textContent = `${cost} 元`;
    leadsValue.textContent = `${leads} 条`;
    hoursValue.textContent = `${hours} 小时`;
    setSliderProgress(costSlider);
    setSliderProgress(leadsSlider);
    setSliderProgress(hoursSlider);

    // Conservative estimate: 30% cost reduction, 50% time savings
    const costSavingsPerLead = cost * 0.3;
    const monthlyCostSavings = costSavingsPerLead * leads;
    const monthlyHoursSaved = hours * 0.5 * 22; // 22 working days
    const hourlyRate = 50; // conservative hourly rate
    const monthlyTimeValue = monthlyHoursSaved * hourlyRate;
    const monthlyTotal = monthlyCostSavings + monthlyTimeValue;
    const annualTotal = monthlyTotal * 12;
    const workdaysSaved = monthlyHoursSaved / 8;

    // Update results
    savingsValue.textContent = `¥${Math.round(monthlyCostSavings).toLocaleString()}`;
    costReduction.textContent = '30%';
    hoursSaved.textContent = `${Math.round(monthlyHoursSaved)} 小时`;
    annualValue.textContent = `¥${Math.round(annualTotal).toLocaleString()}`;
    roiInsight.textContent =
      `按当前参数，每月预计综合节省 ¥${Math.round(monthlyTotal).toLocaleString()}，` +
      `其中可释放约 ${Math.round(monthlyHoursSaved)} 小时，相当于 ${workdaysSaved.toFixed(1)} 个工作日。`;
    if (animate) triggerResultFeedback();
  }

  const handleManualInput = () => {
    setActivePreset('custom');
    calculate();
  };

  costSlider?.addEventListener('input', handleManualInput);
  leadsSlider?.addEventListener('input', handleManualInput);
  hoursSlider?.addEventListener('input', handleManualInput);

  presetButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const preset = button.dataset.roiPreset || 'custom';
      setActivePreset(preset);

      if (preset === 'custom') return;

      costSlider.value = button.dataset.cost || costSlider.value;
      leadsSlider.value = button.dataset.leads || leadsSlider.value;
      hoursSlider.value = button.dataset.hours || hoursSlider.value;
      calculate();
    });
  });

  // Initial calculation
  calculate(false);

  window.addEventListener('visual-story:update', (event) => {
    const detail = (event as CustomEvent<{ section: string }>).detail;
    roiSection?.classList.toggle('story-active', detail.section === 'roi');
  });
</script>
