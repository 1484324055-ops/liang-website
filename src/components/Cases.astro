---
// Cases Section — Real achievements with data
---

<section class="section cases" id="cases" data-story-section="cases">
  <div class="container">
    <div class="section-header reveal">
      <span class="section-label">实战案例</span>
      <h2 class="section-title">用结果说话</h2>
      <p class="section-desc">
        每一个案例都是一线实战，不是 PPT 里的概念。
      </p>
    </div>

    <div class="cases-track" aria-hidden="true">
      <span></span>
      <span></span>
    </div>

    <div class="cases-grid">
      <!-- Case 1: MPE 智能床 -->
      <div class="case-card card reveal" data-case-story="0">
        <div class="case-header">
          <div class="case-header-left">
            <span class="case-brand" style="--brand-color: #2d8cf0">MPE</span>
            <span class="tag">AI + 投放</span>
          </div>
          <span class="case-period">2025.11 — 至今</span>
        </div>
        <h3 class="case-title">MPE 智能床 · 获客成本最高降 80%</h3>
        <p class="case-desc">
          把每天 2 小时的数据整理压到 10 分钟，冷启动 2 个月累计高意向线索 200+ 条。AI 工作流重构了整个投放流程。
        </p>
        <div class="case-metrics">
          <div class="case-metric">
            <span class="case-metric-value">200→50</span>
            <span class="case-metric-label">深圳单条成本（元）</span>
          </div>
          <div class="case-metric">
            <span class="case-metric-value">30-40</span>
            <span class="case-metric-label">全国单条成本（元）</span>
          </div>
          <div class="case-metric">
            <span class="case-metric-value">90%</span>
            <span class="case-metric-label">数据整理时间降幅</span>
          </div>
        </div>
        <button
          type="button"
          class="case-detail-trigger"
          data-case-detail-trigger="mpe"
          aria-haspopup="dialog"
          aria-controls="caseStudyDrawer"
          aria-expanded="false"
        >
          查看案例拆解
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </button>
      </div>

      <!-- Case 2: 爱汤米家居 -->
      <div class="case-card card reveal reveal-delay-1" data-case-story="1">
        <div class="case-header">
          <div class="case-header-left">
            <span class="case-brand" style="--brand-color: #e85d26">爱汤米</span>
            <span class="tag">直播获客</span>
          </div>
          <span class="case-period">2022.10 — 2024.03</span>
        </div>
        <h3 class="case-title">爱汤米家居 · 团队 3→40+ 人</h3>
        <p class="case-desc">
          公司第一个员工，从零搭建直播获客体系。起号 7 个成功 6 个，单月单账号最高 1000+ 留资，最高单月变现 150 万。
        </p>
        <div class="case-metrics">
          <div class="case-metric">
            <span class="case-metric-value counter" data-target="5000" data-suffix="万">5,000万</span>
            <span class="case-metric-label">2023 年全年销售额</span>
          </div>
          <div class="case-metric">
            <span class="case-metric-value">86%</span>
            <span class="case-metric-label">起号成功率（6/7）</span>
          </div>
          <div class="case-metric">
            <span class="case-metric-value counter" data-target="1000" data-suffix="+">1,000+</span>
            <span class="case-metric-label">单月最高留资</span>
          </div>
        </div>
        <button
          type="button"
          class="case-detail-trigger"
          data-case-detail-trigger="aitangmi"
          aria-haspopup="dialog"
          aria-controls="caseStudyDrawer"
          aria-expanded="false"
        >
          查看案例拆解
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </button>
      </div>

      <!-- Case 3: YouTube Shorts -->
      <div class="case-card card reveal reveal-delay-2" data-case-story="2">
        <div class="case-header">
          <div class="case-header-left">
            <span class="case-brand" style="--brand-color: #ff0000">YT</span>
            <span class="tag">AI 内容</span>
          </div>
          <span class="case-period">2026.04</span>
        </div>
        <h3 class="case-title">YouTube Shorts · 半个月 500 万+ 播放</h3>
        <p class="case-desc">
          一个人 + AI，15 天做出 500 万播放。用 Seedance 2.0 批量生成游戏 IP 二创视频，验证了 AI 内容的规模化产出能力。
        </p>
        <div class="case-metrics">
          <div class="case-metric">
            <span class="case-metric-value counter" data-target="500" data-suffix="万+">500万+</span>
            <span class="case-metric-label">总播放量</span>
          </div>
          <div class="case-metric">
            <span class="case-metric-value">15天</span>
            <span class="case-metric-label">达成周期</span>
          </div>
          <div class="case-metric">
            <span class="case-metric-value">1人</span>
            <span class="case-metric-label">独立操盘</span>
          </div>
        </div>
        <button
          type="button"
          class="case-detail-trigger"
          data-case-detail-trigger="youtube"
          aria-haspopup="dialog"
          aria-controls="caseStudyDrawer"
          aria-expanded="false"
        >
          查看案例拆解
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </button>
      </div>

      <!-- Case 4: 欧派家居 -->
      <div class="case-card card reveal reveal-delay-3" data-case-story="3">
        <div class="case-header">
          <div class="case-header-left">
            <span class="case-brand" style="--brand-color: #003399">欧派</span>
            <span class="tag">投放优化</span>
          </div>
          <span class="case-period">2024.07 — 2025.04</span>
        </div>
        <h3 class="case-title">欧派家居 · 获客成本低于行业 30%+</h3>
        <p class="case-desc">
          首月超额完成 200 条线索，创造 30 万业绩。获客成本 130-140 元/条，远低于行业平均水平。账号粉丝从数百增至 10000+，25 倍增长。
        </p>
        <div class="case-metrics">
          <div class="case-metric">
            <span class="case-metric-value">30万</span>
            <span class="case-metric-label">首月业绩</span>
          </div>
          <div class="case-metric">
            <span class="case-metric-value">30%+</span>
            <span class="case-metric-label">低于行业成本</span>
          </div>
          <div class="case-metric">
            <span class="case-metric-value">25×</span>
            <span class="case-metric-label">粉丝增长</span>
          </div>
        </div>
        <button
          type="button"
          class="case-detail-trigger"
          data-case-detail-trigger="oppein"
          aria-haspopup="dialog"
          aria-controls="caseStudyDrawer"
          aria-expanded="false"
        >
          查看案例拆解
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </button>
      </div>

      <!-- Case 5: 栖案柜小程序 -->
      <div class="case-card card reveal reveal-delay-4" data-case-story="4">
        <div class="case-header">
          <div class="case-header-left">
            <span class="case-brand" style="--brand-color: #52c41a">栖案柜</span>
            <span class="tag">AI 产品</span>
          </div>
          <span class="case-period">2026</span>
        </div>
        <h3 class="case-title">栖案柜 · 0 编程独立上线微信小程序</h3>
        <p class="case-desc">
          全屋定制 AI 效果图 Prompt 生成器，0 编程基础全程 AI 协作完成，已通过微信审核上线。技术栈：OpenCode + Codex + GitHub + Vercel。
        </p>
        <div class="case-metrics">
          <div class="case-metric">
            <span class="case-metric-value">0</span>
            <span class="case-metric-label">编程基础</span>
          </div>
          <div class="case-metric">
            <span class="case-metric-value">已上线</span>
            <span class="case-metric-label">微信审核通过</span>
          </div>
          <div class="case-metric">
            <span class="case-metric-value">全AI</span>
            <span class="case-metric-label">协作完成</span>
          </div>
        </div>
        <button
          type="button"
          class="case-detail-trigger"
          data-case-detail-trigger="qian"
          aria-haspopup="dialog"
          aria-controls="caseStudyDrawer"
          aria-expanded="false"
        >
          查看案例拆解
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </button>
      </div>

      <!-- Case 6: OrbitOS -->
      <div class="case-card card reveal reveal-delay-5" data-case-story="5">
        <div class="case-header">
          <div class="case-header-left">
            <span class="case-brand" style="--brand-color: #c9a55c">OrbitOS</span>
            <span class="tag">系统基建</span>
          </div>
          <span class="case-period">2025.11 — 至今</span>
        </div>
        <h3 class="case-title">OrbitOS · 多 AI 协作知识管理系统</h3>
        <p class="case-desc">
          12 类目录架构 + 5 套模板 + 30+ Skill + Hook 自动化 + 多 AI 协作规范。不是用 AI，是让 AI 成为你的操作系统。
        </p>
        <div class="case-metrics">
          <div class="case-metric">
            <span class="case-metric-value counter" data-target="30" data-suffix="+">30+</span>
            <span class="case-metric-label">Skill 数量</span>
          </div>
          <div class="case-metric">
            <span class="case-metric-value">12类</span>
            <span class="case-metric-label">目录架构</span>
          </div>
          <div class="case-metric">
            <span class="case-metric-value">5套</span>
            <span class="case-metric-label">模板</span>
          </div>
        </div>
        <button
          type="button"
          class="case-detail-trigger"
          data-case-detail-trigger="orbitos"
          aria-haspopup="dialog"
          aria-controls="caseStudyDrawer"
          aria-expanded="false"
        >
          查看案例拆解
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .cases {
    overflow: hidden;
  }

  .cases > .container {
    position: relative;
    z-index: 2;
  }

  .cases-track {
    position: absolute;
    z-index: 1;
    inset: 260px max(24px, calc((100% - var(--container-width)) / 2 + 12px)) 84px;
    pointer-events: none;
  }

  .cases-track span {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background: linear-gradient(
      180deg,
      transparent,
      rgba(201, 165, 92, 0.34) 14%,
      rgba(201, 165, 92, 0.08) 78%,
      transparent
    );
    box-shadow: 0 0 18px rgba(201, 165, 92, 0.14);
    opacity: 0.42;
  }

  .cases-track span:first-child {
    left: 2px;
    transform: rotate(-1.3deg);
  }

  .cases-track span:last-child {
    right: 2px;
    transform: rotate(1.3deg);
  }

  .cases-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    perspective: 1400px;
  }

  .case-card {
    --case-depth: 20px;
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    position: relative;
    overflow: hidden;
    transform: perspective(1200px) translate3d(0, 26px, var(--case-depth));
    border-color: rgba(201, 165, 92, 0.08);
    transition:
      transform 0.68s var(--ease-out),
      border-color 0.45s ease,
      box-shadow 0.45s ease,
      background 0.45s ease;
  }

  .case-card:nth-child(even) {
    --case-depth: -34px;
  }

  .case-card::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: 1px;
    height: 100%;
    background: linear-gradient(180deg, transparent, rgba(234, 211, 141, 0.82), transparent);
    opacity: 0;
    transform: scaleY(0.1);
    transition: opacity 0.45s ease, transform 0.75s var(--ease-out);
  }

  .case-card:nth-child(even)::before {
    left: auto;
    right: 0;
  }

  .case-card.story-active {
    transform: perspective(1200px) translate3d(0, 0, 0);
    border-color: rgba(201, 165, 92, 0.3);
    background:
      linear-gradient(145deg, rgba(201, 165, 92, 0.045), transparent 42%),
      var(--bg-card);
    box-shadow:
      0 22px 64px rgba(0, 0, 0, 0.34),
      inset 0 1px 0 rgba(234, 211, 141, 0.08);
  }

  .case-card.story-active::before {
    opacity: 1;
    transform: scaleY(1);
  }

  .case-card.story-active .case-metric-value {
    text-shadow: 0 0 22px rgba(201, 165, 92, 0.24);
  }

  .case-card:first-child {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(280px, 0.65fr);
    column-gap: 52px;
    padding: 42px;
  }

  .case-card:first-child .case-header,
  .case-card:first-child .case-title,
  .case-card:first-child .case-desc {
    grid-column: 1;
  }

  .case-card:first-child .case-title {
    font-size: 26px;
  }

  .case-card:first-child .case-desc {
    font-size: 15px;
    max-width: 680px;
  }

  .case-card:first-child .case-metrics {
    grid-column: 2;
    grid-row: 1 / 4;
    align-self: stretch;
    flex-direction: column;
    justify-content: center;
    padding: 8px 0 8px 36px;
    border-top: 0;
    border-left: 1px solid var(--border);
  }

  .case-card:first-child .case-detail-trigger {
    grid-column: 1;
    justify-self: start;
  }

  .case-card:first-child .case-metric-value {
    font-size: 30px;
  }

  .case-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .case-header-left {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .case-brand {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.5px;
    padding: 3px 10px;
    border-radius: 4px;
    background: rgba(201, 165, 92, 0.12);
    background: color-mix(in srgb, var(--brand-color, var(--accent)) 15%, transparent);
    color: var(--brand-color, var(--accent));
    border: 1px solid rgba(201, 165, 92, 0.2);
    border: 1px solid color-mix(in srgb, var(--brand-color, var(--accent)) 25%, transparent);
    font-family: var(--font-mono);
    text-transform: uppercase;
  }

  .case-period {
    font-size: 12px;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .case-title {
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .case-desc {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.7;
    flex: 1;
  }

  .case-metrics {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
    flex-wrap: wrap;
  }

  .case-metric {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 80px;
  }

  .case-metric-value {
    font-size: 20px;
    font-weight: 800;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }

  .case-metric-label {
    font-size: 12px;
    color: var(--text-muted);
    font-weight: 500;
  }

  .case-detail-trigger {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: 8px;
    min-height: 36px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--accent);
    font-family: inherit;
    font-size: 13px;
    font-weight: 650;
    cursor: pointer;
    transition: color 0.25s ease;
  }

  .case-detail-trigger svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.35s var(--ease-out);
  }

  .case-detail-trigger:hover,
  .case-detail-trigger:focus-visible {
    color: var(--accent-hover);
  }

  .case-detail-trigger:hover svg,
  .case-detail-trigger:focus-visible svg {
    transform: translateX(4px);
  }

  @media (max-width: 1024px) {
    .cases-grid {
      gap: 20px;
    }
  }

  @media (max-width: 768px) {
    .cases-track {
      display: none;
    }

    .cases-grid {
      grid-template-columns: 1fr;
    }

    .case-card {
      padding: 24px;
      transform: translateY(18px);
    }

    .case-card:first-child {
      display: flex;
      grid-column: auto;
      padding: 24px;
    }

    .case-card:first-child .case-title {
      font-size: 18px;
    }

    .case-card:first-child .case-desc {
      font-size: 14px;
    }

    .case-card:first-child .case-metrics {
      flex-direction: row;
      justify-content: space-between;
      padding: 20px 0 0;
      border-top: 1px solid var(--border);
      border-left: 0;
    }

    .case-card:first-child .case-detail-trigger {
      align-self: flex-start;
    }

    .case-card:first-child .case-metric-value {
      font-size: 18px;
    }

    .case-card.story-active {
      transform: translateY(0);
    }

    .case-title {
      font-size: 18px;
    }

    .case-metrics {
      gap: 16px;
    }

    .case-metric-value {
      font-size: 18px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .case-card,
    .case-card.story-active {
      transform: none;
    }
  }
</style>

<script>
  const casesSection = document.querySelector<HTMLElement>('[data-story-section="cases"]');

  if (casesSection && !casesSection.dataset.storyBound) {
    casesSection.dataset.storyBound = 'true';
    const cards = Array.from(casesSection.querySelectorAll<HTMLElement>('[data-case-story]'));
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    window.addEventListener('visual-story:update', (event) => {
      const detail = (event as CustomEvent<{ section: string; progress: number }>).detail;
      if (detail.section !== 'cases') return;

      cards.forEach((card, index) => {
        const threshold = 0.04 + index * 0.13;
        card.classList.toggle('story-active', reducedMotion || detail.progress >= threshold);
      });
    });
  }
</script>
