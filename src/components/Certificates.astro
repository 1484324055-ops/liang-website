---
// Certificates Section — Trust signals with actual certificate images
import { Image } from 'astro:assets';
import certGeminiEducator from '../assets/certs/Gemini教育者认证.png';
import certGeminiTeacher from '../assets/certs/Gemini教师认证.png';
import certGeminiStudent from '../assets/certs/Gemini Certified University Student认证.png';
import certUNESCO from '../assets/certs/联合国科教文组织OER证书.png';
import certAITrainer from '../assets/certs/ai-trainer.jpg';
import certAIJustice from '../assets/certs/人工智能、司法与法治认证.png';
import certLiveMarketing from '../assets/certs/live-marketing.jpg';
---

<section class="section certs" id="certs" data-story-section="certificates">
  <div class="container">
    <div class="section-header reveal">
      <span class="section-label">专业认证</span>
      <h2 class="section-title">权威机构背书</h2>
      <p class="section-desc">
        经过国际权威机构考核认证的 AI 应用能力。
      </p>
    </div>

    <div class="certs-grid">
      <!-- Google Gemini Educator -->
      <div class="cert-card card reveal" data-cert-story="0">
        <button type="button" class="cert-img-wrap" data-cert-open aria-label="查看 Gemini 教育者认证大图">
          <Image src={certGeminiEducator} alt="Gemini 教育者认证" class="cert-img" loading="lazy" width={800} height={600} />
          <span class="cert-shine" aria-hidden="true"></span>
        </button>
        <div class="cert-org">Google for Education</div>
        <h3 class="cert-name">Gemini 教育者认证</h3>
        <p class="cert-name-en" lang="en">Gemini Educator Certification</p>
        <div class="cert-meta">
          <span class="cert-date">2026.06.05</span>
          <span class="cert-valid">谷歌教育部门颁发 · 有效至 2029.06.05</span>
        </div>
      </div>

      <!-- Google Gemini Teacher -->
      <div class="cert-card card reveal reveal-delay-1" data-cert-story="1">
        <button type="button" class="cert-img-wrap" data-cert-open aria-label="查看 Gemini 教师认证大图">
          <Image src={certGeminiTeacher} alt="Gemini 教师认证" class="cert-img" loading="lazy" width={800} height={600} />
          <span class="cert-shine" aria-hidden="true"></span>
        </button>
        <div class="cert-org">Google for Education</div>
        <h3 class="cert-name">Gemini 教师认证</h3>
        <p class="cert-name-en" lang="en">Gemini Certified Teacher</p>
        <div class="cert-meta">
          <span class="cert-date">2026.05.21</span>
          <span class="cert-valid">谷歌教育部门颁发 · 有效至 2029.05.21</span>
        </div>
      </div>

      <!-- Google Gemini University Student -->
      <div class="cert-card card reveal reveal-delay-2" data-cert-story="2">
        <button type="button" class="cert-img-wrap" data-cert-open aria-label="查看 Gemini 大学生认证大图">
          <Image src={certGeminiStudent} alt="Gemini 大学生认证" class="cert-img" loading="lazy" width={800} height={600} />
          <span class="cert-shine" aria-hidden="true"></span>
        </button>
        <div class="cert-org">Google for Education</div>
        <h3 class="cert-name">Gemini 大学生认证</h3>
        <p class="cert-name-en" lang="en">Gemini Certified University Student</p>
        <div class="cert-meta">
          <span class="cert-date">2026.05.21</span>
          <span class="cert-valid">谷歌教育部门颁发 · 有效至 2029.05.21</span>
        </div>
      </div>

      <!-- UNESCO OER -->
      <div class="cert-card card reveal reveal-delay-1" data-cert-story="3">
        <button type="button" class="cert-img-wrap" data-cert-open aria-label="查看 UNESCO OER 证书大图">
          <Image src={certUNESCO} alt="UNESCO OER 证书" class="cert-img" loading="lazy" width={800} height={600} />
          <span class="cert-shine" aria-hidden="true"></span>
        </button>
        <div class="cert-org">联合国教科文组织</div>
        <h3 class="cert-name">开放教育资源开发证书</h3>
        <p class="cert-name-en" lang="en">Open Educational Resources (OER) Development</p>
        <div class="cert-meta">
          <span class="cert-date">2026.05.21</span>
          <span class="cert-valid">UNESCO 颁发 · Prof. Lidia Arthur Brito 签署</span>
        </div>
      </div>

      <!-- Alibaba AI Trainer -->
      <div class="cert-card card reveal reveal-delay-2" data-cert-story="4">
        <button type="button" class="cert-img-wrap" data-cert-open aria-label="查看人工智能训练师高级证书大图">
          <Image src={certAITrainer} alt="人工智能训练师高级" class="cert-img" loading="lazy" width={800} height={600} />
          <span class="cert-shine" aria-hidden="true"></span>
        </button>
        <div class="cert-org">阿里云 · 达摩院</div>
        <h3 class="cert-name">人工智能训练师（高级）</h3>
        <p class="cert-name-en" lang="en">AI Trainer — Advanced Level</p>
        <div class="cert-meta">
          <span class="cert-date">2026.05.21</span>
          <span class="cert-valid">有效至 2027.05.21</span>
        </div>
      </div>

      <!-- AI & Justice -->
      <div class="cert-card card reveal reveal-delay-3" data-cert-story="5">
        <button type="button" class="cert-img-wrap" data-cert-open aria-label="查看人工智能、司法与法治认证大图">
          <Image src={certAIJustice} alt="人工智能、司法与法治认证" class="cert-img" loading="lazy" width={800} height={600} />
          <span class="cert-shine" aria-hidden="true"></span>
        </button>
        <div class="cert-org">牛津大学 · UNESCO</div>
        <h3 class="cert-name">人工智能、司法与法治认证</h3>
        <p class="cert-name-en" lang="en">AI, Justice & Rule of Law</p>
        <div class="cert-meta">
          <span class="cert-date">2026.05.31</span>
          <span class="cert-valid">牛津大学赛德商学院与联合国教科文组织共同开发</span>
        </div>
      </div>

      <!-- 直播运营营销师 -->
      <div class="cert-card card reveal reveal-delay-1" data-cert-story="6">
        <button type="button" class="cert-img-wrap" data-cert-open aria-label="查看直播运营营销师证书大图">
          <Image src={certLiveMarketing} alt="直播运营营销师" class="cert-img" loading="lazy" width={800} height={600} />
          <span class="cert-shine" aria-hidden="true"></span>
        </button>
        <div class="cert-org">行业认证</div>
        <h3 class="cert-name">直播运营营销师</h3>
        <p class="cert-name-en" lang="en">Live Streaming Marketing Professional</p>
        <div class="cert-meta">
          <span class="cert-date">已取得</span>
          <span class="cert-valid">直播电商专业能力认证</span>
        </div>
      </div>
    </div>
  </div>

  <dialog class="cert-lightbox" data-cert-lightbox aria-label="证书大图查看">
    <div class="cert-lightbox-panel">
      <button type="button" class="cert-lightbox-close" data-cert-close aria-label="关闭证书大图">×</button>
      <img class="cert-lightbox-image" data-cert-lightbox-image alt="" />
      <p class="cert-lightbox-caption" data-cert-lightbox-caption></p>
    </div>
  </dialog>
</section>

<style>
  .certs {
    background: var(--bg-surface);
    overflow: clip;
  }

  .certs-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .cert-card {
    --cert-tilt-x: 0deg;
    --cert-tilt-y: 0deg;
    padding: 20px 16px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    transform:
      perspective(1100px)
      translate3d(0, 18px, 0)
      rotateX(var(--cert-tilt-x))
      rotateY(var(--cert-tilt-y));
    transform-style: preserve-3d;
    border-color: rgba(201, 165, 92, 0.08);
    transition:
      transform 0.58s var(--ease-out),
      border-color 0.45s ease,
      box-shadow 0.45s ease;
  }

  .cert-card.story-active {
    transform:
      perspective(1100px)
      translate3d(0, 0, 12px)
      rotateX(var(--cert-tilt-x))
      rotateY(var(--cert-tilt-y));
    border-color: rgba(201, 165, 92, 0.28);
    box-shadow:
      0 20px 58px rgba(0, 0, 0, 0.32),
      inset 0 1px 0 rgba(234, 211, 141, 0.08);
  }

  .cert-img-wrap {
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 8px;
    background: var(--bg);
    border: 1px solid var(--border);
    margin-bottom: 4px;
    transition: all 0.3s var(--ease-out);
    position: relative;
    padding: 0;
    cursor: zoom-in;
    color: inherit;
  }

  .cert-img-wrap:hover {
    border-color: var(--accent);
    box-shadow: 0 4px 20px rgba(201, 165, 92, 0.15);
  }

  .cert-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cert-shine {
    position: absolute;
    inset: -25%;
    background: linear-gradient(
      112deg,
      transparent 36%,
      rgba(255, 249, 224, 0.42) 48%,
      rgba(201, 165, 92, 0.12) 54%,
      transparent 66%
    );
    opacity: 0;
    transform: translateX(-45%);
    pointer-events: none;
  }

  .cert-card.story-active .cert-shine {
    animation: certSurfaceSweep 5.6s ease-in-out infinite;
  }

  @keyframes certSurfaceSweep {
    0%, 58% {
      opacity: 0;
      transform: translateX(-48%);
    }
    68% {
      opacity: 0.54;
    }
    86%, 100% {
      opacity: 0;
      transform: translateX(48%);
    }
  }

  .cert-lightbox {
    width: min(94vw, 1180px);
    max-width: none;
    max-height: 92vh;
    padding: 0;
    border: 1px solid rgba(201, 165, 92, 0.32);
    border-radius: 8px;
    background: rgba(8, 8, 7, 0.96);
    color: var(--text-primary);
    overflow: visible;
    box-shadow: 0 36px 120px rgba(0, 0, 0, 0.72);
    margin: auto;
  }

  .cert-lightbox::backdrop {
    background: rgba(0, 0, 0, 0.82);
    backdrop-filter: blur(8px);
  }

  .cert-lightbox-panel {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    padding: 44px 32px 24px;
  }

  .cert-lightbox-close {
    position: absolute;
    top: 10px;
    right: 12px;
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    border: 1px solid var(--border-light);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.04);
    color: var(--text-primary);
    font: inherit;
    font-size: 24px;
    line-height: 1;
    cursor: pointer;
  }

  .cert-lightbox-close:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .cert-lightbox-image {
    width: auto;
    max-width: 100%;
    max-height: calc(92vh - 112px);
    object-fit: contain;
    border-radius: 4px;
    background: #fff;
  }

  .cert-lightbox-caption {
    font-size: 14px;
    color: var(--text-secondary);
    text-align: center;
  }

  .cert-org {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--accent);
    font-family: var(--font-mono);
  }

  .cert-name {
    font-size: 14px;
    font-weight: 700;
    line-height: 1.3;
  }

  .cert-name-en {
    font-size: 12px;
    color: var(--text-muted);
    font-weight: 500;
  }

  .cert-meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-top: 2px;
  }

  .cert-date {
    font-size: 11px;
    color: var(--text-secondary);
    font-family: var(--font-mono);
  }

  .cert-valid {
    font-size: 11px;
    color: var(--text-muted);
  }

  @media (max-width: 768px) {
    .certs-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }

    .cert-card {
      padding: 16px 12px;
      transform: translateY(12px);
    }

    .cert-card.story-active {
      transform: translateY(0);
    }

    .cert-lightbox-panel {
      padding: 48px 14px 18px;
    }

    .cert-lightbox-image {
      max-height: calc(90vh - 104px);
    }
  }

  @media (max-width: 480px) {
    .certs-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
      max-width: 100%;
    }

    .cert-card {
      padding: 10px 8px;
      gap: 6px;
    }

    .cert-org {
      font-size: 10px;
      letter-spacing: 1px;
    }

    .cert-name {
      font-size: 12px;
    }

    .cert-name-en,
    .cert-date,
    .cert-valid {
      font-size: 10px;
      line-height: 1.35;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cert-card,
    .cert-card.story-active {
      transform: none;
    }

    .cert-shine {
      display: none;
    }
  }
</style>

<script>
  const certificatesSection = document.querySelector<HTMLElement>('[data-story-section="certificates"]');

  if (certificatesSection && !certificatesSection.dataset.storyBound) {
    certificatesSection.dataset.storyBound = 'true';
    const cards = Array.from(certificatesSection.querySelectorAll<HTMLElement>('[data-cert-story]'));
    const openButtons = Array.from(certificatesSection.querySelectorAll<HTMLButtonElement>('[data-cert-open]'));
    const dialog = certificatesSection.querySelector<HTMLDialogElement>('[data-cert-lightbox]');
    const dialogImage = dialog?.querySelector<HTMLImageElement>('[data-cert-lightbox-image]');
    const dialogCaption = dialog?.querySelector<HTMLElement>('[data-cert-lightbox-caption]');
    const closeButton = dialog?.querySelector<HTMLButtonElement>('[data-cert-close]');
    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let activeTrigger: HTMLButtonElement | null = null;

    window.addEventListener('visual-story:update', (event) => {
      const detail = (event as CustomEvent<{ section: string; progress: number }>).detail;
      if (detail.section !== 'certificates') return;

      cards.forEach((card, index) => {
        const threshold = 0.02 + index * 0.105;
        card.classList.toggle('story-active', reducedMotion || detail.progress >= threshold);
      });
    });

    if (finePointer && !reducedMotion) {
      cards.forEach((card) => {
        card.addEventListener('pointermove', (event) => {
          const bounds = card.getBoundingClientRect();
          const x = (event.clientX - bounds.left) / bounds.width - 0.5;
          const y = (event.clientY - bounds.top) / bounds.height - 0.5;
          card.style.setProperty('--cert-tilt-x', `${(-y * 5).toFixed(2)}deg`);
          card.style.setProperty('--cert-tilt-y', `${(x * 5).toFixed(2)}deg`);
        });
        card.addEventListener('pointerleave', () => {
          card.style.setProperty('--cert-tilt-x', '0deg');
          card.style.setProperty('--cert-tilt-y', '0deg');
        });
      });
    }

    openButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const image = button.querySelector<HTMLImageElement>('img');
        const card = button.closest<HTMLElement>('.cert-card');
        const title = card?.querySelector<HTMLElement>('.cert-name')?.textContent?.trim() || image?.alt || '证书';
        if (!dialog || !dialogImage || !dialogCaption || !image) return;

        activeTrigger = button;
        dialogImage.src = image.currentSrc || image.src;
        dialogImage.alt = image.alt;
        dialogCaption.textContent = title;
        if (!dialog.open) {
          document.documentElement.classList.add('cert-lightbox-open');
          document.body.classList.add('cert-lightbox-open');
          dialog.showModal();
        }
      });
    });

    closeButton?.addEventListener('click', () => dialog?.close());
    dialog?.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog?.addEventListener('close', () => {
      document.documentElement.classList.remove('cert-lightbox-open');
      document.body.classList.remove('cert-lightbox-open');
      activeTrigger?.focus();
      activeTrigger = null;
    });
  }
</script>
