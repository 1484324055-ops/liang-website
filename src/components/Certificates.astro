---
// Certificates Section — Trust signals with actual certificate images
import { Image } from 'astro:assets';
import certGeminiEducator from '../assets/certs/Gemini教育者认证.png';
import certGeminiTeacher from '../assets/certs/Gemini教师认证.png';
import certGeminiStudent from '../assets/certs/Gemini Certified University Student认证.png';
import certUNESCO from '../assets/certs/联合国科教文组织OER证书.png';
import certAITrainer from '../assets/certs/ai-trainer.jpg';
import certAIJustice from '../assets/certs/人工智能、司法与法治认证.png';
import certLiveMarketing from '../assets/certs/live-marketing.jpg';
---

<section class="section certs" id="certs">
  <div class="container">
    <div class="section-header reveal">
      <span class="section-label">专业认证</span>
      <h2 class="section-title">权威机构背书</h2>
      <p class="section-desc">
        经过国际权威机构考核认证的 AI 应用能力。
      </p>
    </div>

    <div class="certs-grid">
      <!-- Google Gemini Educator -->
      <div class="cert-card card reveal">
        <div class="cert-img-wrap">
          <Image src={certGeminiEducator} alt="Gemini 教育者认证" class="cert-img" loading="lazy" width={800} height={600} />
        </div>
        <div class="cert-org">Google for Education</div>
        <h3 class="cert-name">Gemini 教育者认证</h3>
        <p class="cert-name-en" lang="en">Gemini Educator Certification</p>
        <div class="cert-meta">
          <span class="cert-date">2026.06.05</span>
          <span class="cert-valid">谷歌教育部门颁发 · 有效至 2029.06.05</span>
        </div>
      </div>

      <!-- Google Gemini Teacher -->
      <div class="cert-card card reveal reveal-delay-1">
        <div class="cert-img-wrap">
          <Image src={certGeminiTeacher} alt="Gemini 教师认证" class="cert-img" loading="lazy" width={800} height={600} />
        </div>
        <div class="cert-org">Google for Education</div>
        <h3 class="cert-name">Gemini 教师认证</h3>
        <p class="cert-name-en" lang="en">Gemini Certified Teacher</p>
        <div class="cert-meta">
          <span class="cert-date">2026.05.21</span>
          <span class="cert-valid">谷歌教育部门颁发 · 有效至 2029.05.21</span>
        </div>
      </div>

      <!-- Google Gemini University Student -->
      <div class="cert-card card reveal reveal-delay-2">
        <div class="cert-img-wrap">
          <Image src={certGeminiStudent} alt="Gemini 大学生认证" class="cert-img" loading="lazy" width={800} height={600} />
        </div>
        <div class="cert-org">Google for Education</div>
        <h3 class="cert-name">Gemini 大学生认证</h3>
        <p class="cert-name-en" lang="en">Gemini Certified University Student</p>
        <div class="cert-meta">
          <span class="cert-date">2026.05.21</span>
          <span class="cert-valid">谷歌教育部门颁发 · 有效至 2029.05.21</span>
        </div>
      </div>

      <!-- UNESCO OER -->
      <div class="cert-card card reveal reveal-delay-1">
        <div class="cert-img-wrap">
          <Image src={certUNESCO} alt="UNESCO OER 证书" class="cert-img" loading="lazy" width={800} height={600} />
        </div>
        <div class="cert-org">联合国教科文组织</div>
        <h3 class="cert-name">开放教育资源开发证书</h3>
        <p class="cert-name-en" lang="en">Open Educational Resources (OER) Development</p>
        <div class="cert-meta">
          <span class="cert-date">2026.05.21</span>
          <span class="cert-valid">UNESCO 颁发 · Prof. Lidia Arthur Brito 签署</span>
        </div>
      </div>

      <!-- Alibaba AI Trainer -->
      <div class="cert-card card reveal reveal-delay-2">
        <div class="cert-img-wrap">
          <Image src={certAITrainer} alt="人工智能训练师高级" class="cert-img" loading="lazy" width={800} height={600} />
        </div>
        <div class="cert-org">阿里云 · 达摩院</div>
        <h3 class="cert-name">人工智能训练师（高级）</h3>
        <p class="cert-name-en" lang="en">AI Trainer — Advanced Level</p>
        <div class="cert-meta">
          <span class="cert-date">2026.05.21</span>
          <span class="cert-valid">有效至 2027.05.21</span>
        </div>
      </div>

      <!-- AI & Justice -->
      <div class="cert-card card reveal reveal-delay-3">
        <div class="cert-img-wrap">
          <Image src={certAIJustice} alt="人工智能、司法与法治认证" class="cert-img" loading="lazy" width={800} height={600} />
        </div>
        <div class="cert-org">牛津大学 · UNESCO</div>
        <h3 class="cert-name">人工智能、司法与法治认证</h3>
        <p class="cert-name-en" lang="en">AI, Justice & Rule of Law</p>
        <div class="cert-meta">
          <span class="cert-date">2026.05.31</span>
          <span class="cert-valid">牛津大学赛德商学院与联合国教科文组织共同开发</span>
        </div>
      </div>

      <!-- 直播运营营销师 -->
      <div class="cert-card card reveal reveal-delay-1">
        <div class="cert-img-wrap">
          <Image src={certLiveMarketing} alt="直播运营营销师" class="cert-img" loading="lazy" width={800} height={600} />
        </div>
        <div class="cert-org">行业认证</div>
        <h3 class="cert-name">直播运营营销师</h3>
        <p class="cert-name-en" lang="en">Live Streaming Marketing Professional</p>
        <div class="cert-meta">
          <span class="cert-date">已取得</span>
          <span class="cert-valid">直播电商专业能力认证</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .certs {
    background: var(--bg-surface);
  }

  .certs-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .cert-card {
    padding: 20px 16px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  .cert-img-wrap {
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 8px;
    background: var(--bg);
    border: 1px solid var(--border);
    margin-bottom: 4px;
    transition: all 0.3s var(--ease-out);
  }

  .cert-img-wrap:hover {
    border-color: var(--accent);
    box-shadow: 0 4px 20px rgba(201, 165, 92, 0.15);
  }

  .cert-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cert-org {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--accent);
    font-family: var(--font-mono);
  }

  .cert-name {
    font-size: 14px;
    font-weight: 700;
    line-height: 1.3;
  }

  .cert-name-en {
    font-size: 12px;
    color: var(--text-muted);
    font-weight: 500;
  }

  .cert-meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-top: 2px;
  }

  .cert-date {
    font-size: 11px;
    color: var(--text-secondary);
    font-family: var(--font-mono);
  }

  .cert-valid {
    font-size: 11px;
    color: var(--text-muted);
  }

  @media (max-width: 768px) {
    .certs-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }

    .cert-card {
      padding: 16px 12px;
    }
  }

  @media (max-width: 480px) {
    .certs-grid {
      grid-template-columns: 1fr;
      max-width: 100%;
    }
  }
</style>
