---
// Contact Section — Social Matrix + CTA
import { Image } from 'astro:assets';
import wechatQR from '../assets/images/wechat-qr.png';
---

<section class="section contact" id="contact">
  <div class="container">
    <div class="contact-layout">
      <!-- Left: CTA -->
      <div class="contact-cta reveal">
        <span class="section-label">联系我</span>
        <h2 class="section-title">让我们一起，<br />用 AI 解决真问题</h2>
        <p class="section-desc" style="max-width: 520px;">
          无论你是想了解 AI 如何赋能你的业务，<br />
          还是已经有明确的 AI 落地需求，都欢迎来聊。
        </p>
        <div class="contact-qr">
          <Image src={wechatQR} alt="微信二维码 - 扫码添加阿杰" class="contact-qr-img" loading="lazy" />
          <span class="contact-qr-hint">扫码添加微信 · 请备注「来自网站」</span>
        </div>
      </div>

      <!-- Right: Social Links -->
      <div class="contact-social reveal reveal-delay-1">
        <h3 class="social-title">在这些平台也能找到我</h3>
        <p class="social-desc">我在这几个平台持续输出 AI 实战内容，关注任意平台都能获取最新动态。</p>

        <div class="social-grid">
          <!-- 小红书 -->
          <a href="https://xhslink.com/m/7htcBmaHvMh" target="_blank" rel="noopener noreferrer" class="social-card card">
            <div class="social-icon social-icon-xhs">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
