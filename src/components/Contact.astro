              </svg>
            </div>
            <div class="social-info">
              <span class="social-name">小红书</span>
              <span class="social-handle">@Jcut · 1,249 粉丝</span>
            </div>
            <svg class="social-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M4 12l8-8M12 4v8M12 4H4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>

          <!-- 抖音 -->
          <a href="https://v.douyin.com/n4Uw16gQ4J4/" target="_blank" rel="noopener noreferrer" class="social-card card">
            <div class="social-icon social-icon-dy">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1v-3.5a6.37 6.37 0 0 0-.79-.05A6.34 6.34 0 0 0 3.15 15.2a6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.34-6.34V8.98a8.21 8.21 0 0 0 4.76 1.5V7.04a4.84 4.84 0 0 1-1-.35z"/>
              </svg>
            </div>
            <div class="social-info">
              <span class="social-name">抖音</span>
              <span class="social-handle">@阿杰 Thinking · 2,932 粉丝</span>
            </div>
            <svg class="social-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M4 12l8-8M12 4v8M12 4H4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>

          <!-- 公众号 -->
          <a href="https://mp.weixin.qq.com/mp/profile_ext?action=home&__biz=MzY5NzIzNzExMg==#wechat_redirect" target="_blank" rel="noopener noreferrer" class="social-card card">
            <div class="social-icon social-icon-wx">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M8.691 2.188C3.891 2.188 0 5.476 0 9.53c0 2.212 1.17 4.203 3.002 5.55a.59.59 0 0 1 .213.665l-.39 1.48c-.019.07-.048.141-.048.213 0 .163.13.295.29.295a.326.326 0 0 0 .167-.054l1.903-1.114a.864.864 0 0 1 .717-.098 10.16 10.16 0 0 0 2.837.403c.276 0 .543-.027.811-.05-.857-2.578.157-4.972 1.932-6.446 1.703-1.415 3.882-1.98 5.853-1.838-.576-3.583-4.196-6.348-8.596-6.348zM5.785 5.991c.642 0 1.162.529 1.162 1.18a1.17 1.17 0 0 1-1.162 1.178A1.17 1.17 0 0 1 4.623 7.17c0-.651.52-1.18 1.162-1.18zm5.813 0c.642 0 1.162.529 1.162 1.18a1.17 1.17 0 0 1-1.162 1.178 1.17 1.17 0 0 1-1.162-1.178c0-.651.52-1.18 1.162-1.18zm5.34 2.867c-1.797-.052-3.746.512-5.28 1.786-1.72 1.428-2.687 3.72-1.78 6.22.942 2.453 3.666 4.229 6.884 4.229.826 0 1.622-.12 2.361-.336a.722.722 0 0 1 .598.082l1.584.926a.272.272 0 0 0 .14.045c.133 0 .24-.11.24-.245 0-.06-.024-.12-.04-.178l-.326-1.233a.493.493 0 0 1 .177-.554C23.216 18.504 24 16.92 24 15.176c0-3.33-3.037-6.057-7.062-6.318zm-2.89 2.065c.535 0 .969.44.969.983a.976.976 0 0 1-.969.983.976.976 0 0 1-.969-.983c0-.542.434-.983.97-.983zm4.844 0c.535 0 .969.44.969.983a.976.976 0 0 1-.969.983.976.976 0 0 1-.969-.983c0-.542.434-.983.97-.983z"/>
              </svg>
            </div>
            <div class="social-info">
              <span class="social-name">公众号</span>
              <span class="social-handle">@Jcut · 111 关注</span>
            </div>
            <svg class="social-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M4 12l8-8M12 4v8M12 4H4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>

          <!-- YouTube -->
          <a href="https://youtube.com/@zhenjie9267" target="_blank" rel="noopener noreferrer" class="social-card card">
            <div class="social-icon social-icon-yt">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
              </svg>
            </div>
            <div class="social-info">
              <span class="social-name">YouTube</span>
              <span class="social-handle">@zhenjie9267 · 2,235 订阅</span>
            </div>
            <svg class="social-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M4 12l8-8M12 4v8M12 4H4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    background: var(--bg-surface);
  }

  .contact-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }

  .contact-cta .section-title {
    text-align: left;
  }

  .contact-cta .section-label {
    text-align: left;
  }

  .contact-cta .contact-qr-hint {
    text-align: left;
  }

  .contact-cta .section-desc {
    margin-bottom: 32px;
  }

  .contact-qr {
    margin-top: 32px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: flex-start;
    width: 280px;
  }

  .contact-qr-img {
    width: 100%;
    border-radius: 12px;
    border: 2px solid var(--border);
    background: #fff;
    transition: all 0.3s var(--ease-out);
    display: block;
  }

  .contact-qr-img:hover {
    border-color: var(--accent);
    box-shadow: 0 8px 30px rgba(201, 165, 92, 0.2);
    transform: scale(1.02);
  }

  .contact-qr-hint {
    font-size: 13px;
    color: var(--text-muted);
    text-align: center;
    width: 100%;
  }

  .social-title {
    font-size: 20px;
    font-weight: 700;
    margin-bottom: 8px;
  }

  .social-desc {
    font-size: 14px;
    color: var(--text-secondary);
    margin-bottom: 32px;
    line-height: 1.7;
  }

  .social-grid {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .social-card {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 20px;
    text-decoration: none;
    color: var(--text-primary);
  }

  .social-card:hover {
    color: var(--text-primary);
  }

  .social-icon {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    flex-shrink: 0;
  }

  .social-icon-xhs {
    background: rgba(255, 45, 85, 0.1);
    color: #ff2d55;
  }

  .social-icon-dy {
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
  }

  .social-icon-wx {
    background: rgba(7, 193, 96, 0.1);
    color: #07c160;
  }

  .social-icon-x {
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
  }

  .social-icon-yt {
    background: rgba(255, 0, 0, 0.1);
    color: #ff0000;
  }

  .social-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .social-name {
    font-size: 14px;
    font-weight: 600;
  }

  .social-handle {
    font-size: 12px;
    color: var(--text-muted);
  }

  .social-arrow {
    color: var(--text-muted);
    transition: all 0.3s var(--ease-out);
    flex-shrink: 0;
  }

  .social-card:hover .social-arrow {
    color: var(--accent);
    transform: translate(2px, -2px);
  }

  @media (max-width: 1024px) {
    .contact-layout {
      gap: 60px;
    }

    .contact-qr-img {
      max-width: 240px;
    }
  }

  @media (max-width: 768px) {
    .contact-layout {
      grid-template-columns: 1fr;
      gap: 60px;
    }

    .contact-cta {
      text-align: center;
    }

    .contact-cta .section-title,
    .contact-cta .section-label,
    .contact-cta .contact-qr-hint {
      text-align: center;
    }

    .contact-cta .section-desc {
      margin: 0 auto 32px;
    }

    .contact-qr {
      align-items: center;
    }

    .contact-qr-img {
      max-width: 280px;
    }

    .social-card {
      padding: 14px 16px;
    }
  }

  @media (max-width: 480px) {
    .contact-qr-img {
      max-width: 240px;
    }
  }
</style>
